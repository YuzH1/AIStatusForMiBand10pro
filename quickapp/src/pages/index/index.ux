<template>
  <div class="page" style="height: {{pageH}}px">
    <div class="header">
      <image src="/common/images/back.png" static class="back-btn" @click="goBack" />
      <text class="title">AI额度</text>
      <text class="conn {{connClass}}">{{connText}}</text>
    </div>
    <text class="update">更新于 {{lastUpdate}}</text>

    <list class="list" id="quotaList" style="height: {{listH}}px">
      <list-item type="item" for="{{accounts}}" class="item-card">
        <div class="card-head">
          <text class="acc-name">{{$item.name}}</text>
          <text class="acc-type">{{$item.typeText}}</text>
        </div>
        <div class="row-main">
          <text class="acc-remain {{$item.remainClass}}">{{$item.remainingText}}</text>
          <text class="acc-used">{{$item.usedText}}</text>
        </div>
        <div class="bar" if="{{$item.hasBar}}">
          <div class="bar-fill {{$item.barClass}}" style="width: {{$item.barWidth}}%"></div>
        </div>
        <text class="acc-detail">{{$item.detailText}}</text>
        <text class="acc-error" if="{{$item.error}}">{{$item.error}}</text>
      </list-item>
    </list>

    <text class="empty" if="{{accounts.length === 0}}">暂无账户数据</text>
    <text class="empty" if="{{dataHint}}">{{dataHint}}</text>

    <div class="actions">
      <input type="button" class="btn btn-primary" value="刷新" @click="handleRefresh" />
      <input type="button" class="btn" value="诊断" @click="handleDiagnose" />
    </div>

    <text class="toast" if="{{toast}}">{{toast}}</text>
  </div>
</template>

<script>
import interconn from '../../utils/interconn'
import api from '../../utils/api'
import store from '../../utils/store'
import fmt from '../../utils/format'
import device from '@system.device'
import router from '@system.router'

const AUTO_REFRESH_MS = 5 * 60 * 1000
const LOW_PERCENT = 10

export default {
  private: {
    accounts: [],
    connClass: '',
    connText: '连接中...',
    lastUpdate: '--',
    toast: '',
    timer: null,
    connected: false,
    dataHint: '',
    pageH: 300,
    listH: 180
  },
  onShow() {
    console.log('[ai-quota] onShow')
    this.initBridge()
    this.restoreCache()
    this.startTimer()
    this.computeLayout()
    if (interconn.getReadyState() === 1) {
      this.connText = '已连接'
      this.connClass = 'conn-ok'
      this.requestData(false)
    } else if (this.accounts.length === 0) {
      this.connText = '连接中...'
      this.connClass = ''
    }
  },
  onHide() {
    console.log('[ai-quota] onHide')
    this.stopTimer()
  },
  onReady() {
    console.log('[ai-quota] onReady')
    this.computeLayout()
  },
  computeLayout() {
    device.getInfo({
      success: (info) => {
        const w = info.screenWidth || 0
        const h = info.screenHeight || 0
        if (w > 0 && h > 0) {
          const scale = w / 212
          let ph = Math.round(h / scale)
          ph = Math.max(240, Math.min(380, ph))
          this.pageH = ph
          this.listH = ph - 120
          console.log('[ai-quota] screen ' + w + 'x' + h + ' pageH=' + ph)
        } else {
          this.pageH = 300
          this.listH = 180
        }
      },
      fail: () => {
        this.pageH = 300
        this.listH = 180
      }
    })
  },
  initBridge() {
    if (this._inited) return
    this._inited = true
    interconn.init()

    interconn.onState((state) => {
      this.connected = state === 1
      if (state === 1) {
        this.connText = '已连接'
        this.connClass = 'conn-ok'
        this.requestData(false)
      } else {
        this.connText = this.accounts.length > 0 ? '连接断开' : '未连接'
        this.connClass = 'conn-bad'
      }
    })

    api.on('update.quota', (data) => {
      console.log('[ai-quota] update.quota event')
      if (data && data.accounts) {
        this.applyAccounts(data.accounts)
        this.connected = true
        this.connText = '已连接'
        this.connClass = 'conn-ok'
      } else {
        this.dataHint = '事件无账户字段'
      }
    })
  },
  restoreCache() {
    store.get('accounts', []).then((cached) => {
      if (cached && cached.length) this.applyAccounts(cached, true)
    })
    store.get('lastUpdate', null).then((t) => {
      if (t) this.lastUpdate = fmt.fmtTime(t)
    })
  },
  requestData(fresh) {
    const p = fresh ? api.refreshQuota() : api.listQuota()
    p.then((res) => {
      this.connected = true
      this.connText = '已连接'
      this.connClass = 'conn-ok'
      if (res && res.accounts) {
        this.applyAccounts(res.accounts)
      } else {
        this.dataHint = '响应中无账户字段'
      }
    }).catch((err) => {
      console.warn('[ai-quota] requestData failed', JSON.stringify(err))
      if (this.accounts.length === 0) {
        this.connText = '未连接'
        this.connClass = 'conn-bad'
        this.dataHint = '未连接手机'
      } else {
        this.dataHint = '连接异常，显示缓存数据'
      }
    })
  },
  applyAccounts(list, fromCache) {
    const items = list.map((a) => {
      const pct = fmt.percent(a.remaining, a.total)
      let remainClass = ''
      let barClass = ''
      if (a.status === 'error') {
        remainClass = 'acc-remain-bad'
        barClass = 'bar-fill-bad'
      } else if (pct !== null && pct <= LOW_PERCENT) {
        remainClass = 'acc-remain-low'
        barClass = 'bar-fill-low'
      }
      return {
        name: a.name || '未命名',
        typeText: fmt.providerLabel(a.type),
        remainingText: fmt.remainingText(a),
        usedText: fmt.usedText(a),
        detailText: fmt.detailText(a),
        barWidth: pct === null ? 0 : Math.round(pct),
        hasBar: pct !== null,
        remainClass: remainClass,
        barClass: barClass,
        error: a.status === 'error' ? (a.error || '查询失败') : ''
      }
    })
    this.accounts = items
    this.dataHint = items.length === 0 ? '手机端账户列表为空' : ''
    if (fromCache) return
    this.lastUpdate = fmt.fmtTime(Date.now())
    store.set('accounts', items)
    store.set('lastUpdate', Date.now())
  },
  handleRefresh() {
    this.toast = '刷新中...'
    api.refreshQuota()
      .then((res) => {
        if (res && res.accounts) this.applyAccounts(res.accounts)
        this.showToast('刷新成功')
      })
      .catch((err) => {
        console.warn('[ai-quota] refresh failed', JSON.stringify(err))
        this.showToast(err && err.msg ? err.msg : '刷新失败')
      })
  },
  handleDiagnose() {
    this.showToast('诊断中...')
    interconn.diagnose(10000)
      .then((res) => {
        const status = res && res.data ? res.data.status : res && res.status
        this.showToast(status === 0 ? '连接正常' : '连接异常 ' + status)
      })
      .catch((err) => {
        this.showToast('未连接: ' + (err && err.code))
      })
  },
  startTimer() {
    this.stopTimer()
    this.timer = setInterval(() => {
      console.log('[ai-quota] auto refresh')
      this.requestData(true)
    }, AUTO_REFRESH_MS)
  },
  stopTimer() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },
  showToast(msg) {
    this.toast = msg
    setTimeout(() => {
      this.toast = ''
    }, 2000)
  },
  goBack() {
    console.log('[ai-quota] goBack')
    router.back()
  }
}
</script>

<style>
.page {
  width: 212px;
  padding: 8px;
  flex-direction: column;
}

.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 26px;
}

.back-btn {
  width: 24px;
  height: 24px;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #ffffff;
}

.conn {
  font-size: 12px;
  color: #8a8f98;
}

.conn-ok {
  color: #2ea0ff;
}

.conn-bad {
  color: #ff6b4a;
}

.update {
  margin-top: 2px;
  font-size: 10px;
  color: #5c6068;
}

.list {
  width: 212px;
  margin-top: 6px;
  margin-bottom: 48px;
}

.item-card {
  width: 196px;
  height: 104px;
  padding: 9px 11px;
  margin-bottom: 8px;
  background-color: #16191f;
  border-radius: 14px;
  flex-direction: column;
  justify-content: space-between;
}

.card-head {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.acc-name {
  font-size: 15px;
  font-weight: bold;
  color: #ffffff;
}

.acc-type {
  font-size: 10px;
  color: #9aa3af;
  padding: 2px 8px;
  border-radius: 9px;
  background-color: #1d2633;
}

.row-main {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.acc-remain {
  font-size: 19px;
  font-weight: bold;
  color: #ffffff;
}

.acc-remain-low {
  color: #ff9f1c;
}

.acc-remain-bad {
  color: #ff6b4a;
}

.acc-used {
  font-size: 11px;
  color: #8a8f98;
}

.bar {
  height: 3px;
  border-radius: 2px;
  background-color: #262b33;
  flex-direction: row;
}

.bar-fill {
  height: 3px;
  border-radius: 2px;
  background-color: #2ea0ff;
}

.bar-fill-low {
  background-color: #ff9f1c;
}

.bar-fill-bad {
  background-color: #ff6b4a;
}

.acc-detail {
  font-size: 10px;
  color: #6b7280;
}

.acc-error {
  font-size: 10px;
  color: #ff6b4a;
}

.actions {
  position: absolute;
  left: 0px;
  bottom: 0px;
  width: 212px;
  padding: 8px;
  background-color: #000000;
  flex-direction: row;
  justify-content: space-between;
}

.btn {
  width: 96px;
  height: 30px;
  border-radius: 22px;
  font-size: 13px;
  color: #ffffff;
  background-color: #1d2633;
  text-align: center;
}

.btn-primary {
  background-color: #14539a;
}

.empty {
  margin-top: 40px;
  text-align: center;
  font-size: 13px;
  color: #8a8f98;
}

.toast {
  margin-top: 8px;
  padding: 8px;
  background-color: #22262e;
  border-radius: 8px;
  text-align: center;
  font-size: 12px;
  color: #ffffff;
}
</style>